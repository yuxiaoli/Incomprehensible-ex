[
    {
        "caption": "Tools",
        "mnemonic": "T",
        "id": "tools",
        "children":
        [
            {
                "caption": "Imcomprehensible Ex",
                "children":
                [
                    {
                        "command": "incomprehensible_ex_edit_mode_on",
                        "caption": "Edit Mode ON"
                    },
                    {
                        "command": "incomprehensible_ex_edit_mode_off",
                        "caption": "Edit Mode OFF"
                    },
                ]
            }

        ]
    },
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children":
        [
            {
                "caption": "Package Settings",
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "Incomprehensible Ex",
                        "children":
                        [
                            {
                                "caption": "Manage Settings",
                                "command": "open_file",
                                "args": {
                                    "file": "${packages}/User/incomprehensibleex.sublime-settings"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
