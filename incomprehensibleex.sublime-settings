{
    // File extensions that open through Incomprehensible Ex.
    "extensions":
    [
        "mp3",
        "odt",
        "ogg",
        "pdf",
        "pptx",
        "ps",
        "psv",
        "rtf",
        "tff",
        "tif",
        "tiff",
        "tsv",
        "wav",
        "xls",
        "xlsx",
        "doc",
        "docx",
        "eml",
        "epub"
    ],

    // When enabled, saving a `.inex` buffer writes it back through pandoc.
    "edit_mode": false,

    // Extraction engines used when opening a supported document.
    // The "default" key defines the fallback engine.
    // You can also define extension-specific engines (e.g., "pdf": "pymupdf").
    // Supported engines: "docling", "markitdown", "pandoc", "pymupdf", "pdfly", "python-docx", "python-pptx", "openpyxl".
    // Save mode still uses pandoc for document export.
    "engines": {
        "default": "docling",
        "pdf": "pymupdf",
        "docx": "python-docx",
        "pptx": "python-pptx",
        "xlsx": "openpyxl"
    }
}
